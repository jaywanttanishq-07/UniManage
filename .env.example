# ─────────────────────────────────────────────────────────────
#  UniManage — Environment Variables
#  Copy this file to .env and fill in the values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
# Full connection string (takes precedence over individual vars)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unimanage

# Individual connection vars (used by drizzle-kit and pg Pool fallback)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=unimanage

# ── API Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (production only).
# In development this is ignored — all origins are allowed.
# Example: ALLOWED_ORIGINS=https://unimanage.yourdomain.com
ALLOWED_ORIGINS=

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ── Frontend (Vite) ───────────────────────────────────────────
# Port the Vite dev server listens on
VITE_PORT=5173

# Base path (leave as / for local dev)
BASE_PATH=/

# Backend API URL used by the frontend at runtime
VITE_API_URL=http://localhost:3001
